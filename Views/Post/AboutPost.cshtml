@{
    ViewData["Title"] = "Create Post";
}

<h1>Create a New Post</h1>

<div>
    <div class="form-group">
        <label>Post Name</label>
        <input type="text" id="postName" class="form-control" />
    </div>
    <div class="form-group">
        <label>Detail</label>
        <textarea id="detail" class="form-control"></textarea>
    </div>
    <div class="form-group">
        <label>Max Participants</label>
        <input type="number" id="maxParticipant" class="form-control" min="1" />
    </div>
    <div class="form-group">
        <label>Cover Page Image URL</label>
        <input type="text" id="coverPageImg" class="form-control" />
    </div>
    <div class="form-group">
        <label>Activity Types (Comma Separated IDs)</label>
        <input type="text" id="actTypes" class="form-control" placeholder="e.g., 1,2,3" />
    </div>
    <div class="form-group">
        <label>Open Date Time</label>
        <input type="datetime-local" id="openDateTime" class="form-control" />
    </div>
    <div class="form-group">
        <label>Close Date Time</label>
        <input type="datetime-local" id="closeDateTime" class="form-control" />
    </div>
    <div class="form-group">
        <label>Activity Date Time</label>
        <input type="datetime-local" id="actDatetime" class="form-control" />
    </div>
    <div class="form-group">
        <label>Location</label>
        <input type="text" id="location" class="form-control" />
    </div>
    <div class="form-group">
        <input type="checkbox" id="isAttached" /> <label>Is Attached</label>
    </div>
    <div id="error" style="color: red;"></div>
    <button type="button" class="btn btn-primary mt-4" onclick="createPost()">Create Post</button>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    async function createPost() {

        function getCookie(name) {
        let cookieArr = document.cookie.split(";");
        for (let i = 0; i < cookieArr.length; i++) {
            let cookie = cookieArr[i].trim();
            if (cookie.startsWith(name + "=")) {
                return cookie.substring(name.length + 1);
            }
        }
        return null;
    }

        let token = getCookie("token");
        if (token) {
            console.log("Token found:", token);
        } else {
            console.log("Token not found");
        }

        let postData = {
            postName: document.getElementById("postName").value,
            detail: document.getElementById("detail").value,
            isAttached: document.getElementById("isAttached").checked,
            maxParticipant: parseInt(document.getElementById("maxParticipant").value),
            coverPageImg: document.getElementById("coverPageImg").value,
            actTypes: document.getElementById("actTypes").value.split(',').map(Number),
            locations: document.getElementById("location").value,
            openDateTime: document.getElementById("openDateTime").value,
            closeDateTime: document.getElementById("closeDateTime").value,
            actDatetime: document.getElementById("actDatetime").value,
        };

        try {
            let response = await $.ajax({
                url: "/api/post/createpost",
                type: "POST",
                contentType: "application/json",
                headers: { "Authorization": `Bearer ${token}` },
                data: JSON.stringify(postData)
            });

            alert("Post Created Successfully!");
            console.log("Post Created:", response);
        } catch (err) {
            document.getElementById("error").innerText = err.responseJSON?.message || "Failed to create post.";
            console.error("Error:", xhr.responseText); // ดูรายละเอียด Error
            alert("Failed to create post: " + xhr.responseText);
        }
    }
</script>
