<div>
    <button onclick="getPosts()">Get All Posts</button>
    <ul id="postList"></ul> <!-- ที่จะแสดงโพสต์ทั้งหมด -->
    <div id="error"></div>
</div>

<script>
  async function getPosts() {
    function getCookie(name) {
        let cookieArr = document.cookie.split(";");
        for (let i = 0; i < cookieArr.length; i++) {
            let cookie = cookieArr[i].trim();
            if (cookie.startsWith(name + "=")) {
                return cookie.substring(name.length + 1);
            }
        }
        return null;
    }

    let token = getCookie("token");

    if (!token) {
        document.getElementById("error").innerText = "Please login first.";
        return;
    }

    try {
        let response = await fetch("/api/post/allposts", {
            method: "GET",
            headers: {
                "Authorization": `Bearer ${token}`
            }
        });

        if (!response.ok) {
            throw new Error("Failed to fetch posts");
        }

        let data = await response.json();
        console.log("All Posts:", data);

        let postList = document.getElementById("postList");
        postList.innerHTML = '';  

        data.forEach(post => {
            let listItem = document.createElement("li");

            let postContent = `
                <strong>${post.postName}</strong><br>
                ${post.detail}<br>
                <strong>Post by:</strong> ${post.user ? post.user.username : 'Unknown'}<br>
                <strong>Status:</strong> ${post.status}<br>
                <strong>Max Participants:</strong> ${post.maxParticipant}<br>
                <strong>Is Attached:</strong> ${post.isAttached ? 'Yes' : 'No'}<br>
                <strong>Location:</strong> ${post.locations}<br>
                <strong>Cover Image:</strong> <img src="${post.coverPageImg}" alt="Cover Image" width="100"><br>
                <strong>Created Date:</strong> ${post.createAt ? new Date(post.createAt).toLocaleString() : 'N/A'}<br>
                <strong>Likes:</strong> <span id="likeCount-${post.id}">${post.like}</span>  
                <button id="likeButton-${post.id}" onclick="toggleLike(${post.id})">Like</button> 
            `;

            listItem.innerHTML = postContent;
            postList.appendChild(listItem);
        });

        document.getElementById("error").innerText = "";

    } catch (err) {
        console.error("Error fetching posts:", err);
        document.getElementById("error").innerText = "Failed to load posts.";
    }
  }

  async function toggleLike(postId) {
    
    function getCookie(name) {
        let cookieArr = document.cookie.split(";");
        for (let i = 0; i < cookieArr.length; i++) {
            let cookie = cookieArr[i].trim();
            if (cookie.startsWith(name + "=")) {
                return cookie.substring(name.length + 1);
            }
        }
        return null;
    }
    let token = getCookie("token");

    if (!token) {
        alert("Please login first.");
        return;
    }

    try {
        let response = await fetch(`/api/post/togglelike/${postId}`, {
            method: "POST",
            headers: {
                "Authorization": `Bearer ${token}`,
                "Content-Type": "application/json"
            }
        });

        if (!response.ok) {
            let errorMessage = await response.text();
            alert(errorMessage);
            return;
        }

        let newLikeCount = await response.json();
        document.getElementById(`likeCount-${postId}`).innerText = newLikeCount;

        let likeButton = document.getElementById(`likeButton-${postId}`);
        if (likeButton.innerText === "Like") {
            likeButton.innerText = "Unlike";
        } else {
            likeButton.innerText = "Like";
        }

    } catch (err) {
        console.error("Error liking post:", err);
        alert("Failed to like post.");
    }
  }
</script>
