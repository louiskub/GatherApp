@model GatherApp.Models.User

@{
    ViewData["Title"] = "Gather-SignUp";
}

<link rel="stylesheet" href="~/css/Auth/Signup2.css" />
<title>Signup Page</title>

<div class="main">
    <h1 class="top">Sign Up</h1>
    <div class="page">
        <div class="containerStyle">
            <label class="label" for="username">Username :</label>
            <input
                type="text"
                id="username"
                class="inputBox"
                placeholder="Enter your username"
                required
            />
        </div>

        <div class="containerStyle">
            <label class="label" for="email">E-mail :</label>
            <input
                type="email"
                id="email"
                class="inputBox"
                placeholder="Enter your email"
                required
            />
        </div>

        <div class="containerStyle">
            <label class="label" for="firstName">First Name :</label>
            <input
                type="text"
                id="firstName"
                class="inputBox"
                placeholder="Enter your first name"
                required
            />
        </div>

        <div class="containerStyle">
            <label class="label" for="lastName">Last Name :</label>
            <input
                type="text"
                id="lastName"
                class="inputBox"
                placeholder="Enter your last name"
                required
            />
        </div>

        <div class="containerStyle">
            <label class="label" for="dob">Date of Birth :</label>
            <input
                type="date"
                id="dob"
                class="inputBox"
                required
            />
        </div>

        <div class="containerStyle">
            <label class="label" for="password">Password :</label>
            <div class="inputWrapper">
                <input
                    type="password"
                    id="password"
                    class="inputBox"
                    placeholder="Enter your password"
                    required
                />
                <button type="button" id="togglePassword" class="visibleButton">
                    <img
                        src="https://cdn-icons-png.flaticon.com/512/6405/6405909.png"
                        alt="Show"
                        id="icon"
                    />
                </button>
            </div>
        </div>

        <div class="containerStyle">
            <label class="label" for="confirmPassword">Repeat Password :</label>
            <div class="inputWrapper">
                <input
                    type="password"
                    id="confirmPassword"
                    class="inputBox"
                    placeholder="Repeat your password"
                    required
                />
            </div>
        </div>

        <div class="buttonContainer">
            <div class="containerStyle">
                <button class="buttonStyle" id="signupButton">Sign Up</button>
            </div>

            <div class="containerStyle">
                <p class="textStyle">Already a member?</p>
                <a href="/login" class="link">Log In</a>
            </div>
        </div>
    </div>
    <script src="~/js/Auth/Signup.js"></script>
</div>

<script>
    document.getElementById("signupButton").addEventListener("click", function (event) {
        event.preventDefault();  // Prevent form submission

        // Get input values
        const username = document.getElementById("username").value;
        const email = document.getElementById("email").value;
        const firstName = document.getElementById("firstName").value;
        const lastName = document.getElementById("lastName").value;
        const dob = document.getElementById("dob").value;
        const password = document.getElementById("password").value;
        const confirmPassword = document.getElementById("confirmPassword").value;

        // Validate the passwords match
        if (password !== confirmPassword) {
            alert("Passwords do not match!");
            return;
        }

        const data = {
            Username: username,
            Email: email,
            FirstName: firstName,
            LastName: lastName,
            DateOfBirth: dob,
            Password: password
        };

        // Send registration request to the backend
        fetch('/api/auth/register', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify(data),
        })
        .then(response => response.json())
        .then(data => {
            if (data.status === "Registration successful") {
                alert('Registration successful.');
                window.location.href = '/auth/login';
            } else if (data.errors) {
                alert('Registration failed: ' + data.errors.join('\n'));
            } else {
                alert('Registration failed: ' + data.status);
            }
        })
        .catch(error => {
            console.error(error);
            alert('Registration failed: ' + error.message);
        });
    });
</script>
