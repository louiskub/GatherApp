@model GatherApp.Models.User

@{
    ViewData["Title"] = "Gather-SignUp";
}

<link rel="stylesheet" href="~/css/Auth/Signup2.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">

<title>Signup Page</title>

<div class="main">
    <form class="signup-container">
        <h1 class="signup-title">Sign Up</h1>

        <div class="signup-content">
            <section class="signup-first-step">
                <div class="signup-realname">
                    <div class="signup-firstname">
                        <label class="label" for="firstName">First Name</label>
                        <input type="text" id="firstName" class="inputBox" placeholder="Enter your first name" required />
                    </div>
                    <div class="signup-lastname">
                        <label class="label" for="lastName">Last Name</label>
                        <input type="text" id="lastName" class="inputBox" placeholder="Enter your last name" required />
                    </div>
                </div>
                <div class="signup-birthdate">
                    <label class="label" for="dob">Date of Birth</label>
                    @* <input type="date" id="dob" class="inputBox" required /> *@
                    <input type="text" id="datePicker" class="inputBox" placeholder="Select your date of birth" required />
                </div>
                <div class="signup-gender">
                    <label class="label" for="gender">Gender</label>
                    <select name="gender-selecter" id="genderSelecter" class="inputBox" required>
                        <option value="Null" disabled selected>Select your gender</option>
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                        <option value="Non-Binary">Non-Binary</option>
                        <option value="Prefer not to say">Prefer not to say</option>
                        <option value="Custom">Custom</option>
                    </select>
                    <input type="text" id="customGenderInput" class="inputBox" placeholder="Enter your gender">
                </div>
                <button id="signupNextButton" class="signup-next-button">Next</button>
            </section>
            <section class="signup-last-step">
                <div class="signup-username">
                    <label class="label" for="username">Username</label>
                    <input type="text" id="username" class="inputBox" placeholder="Choose your username" required />
                </div>
                <div class="signup-email">
                    <label class="label" for="email">Email</label>
                    <input type="email" id="email" class="inputBox" placeholder="Enter your email" required />
                </div>
                <div class="signup-password">
                    <label class="label" for="password">Password</label>
                    <div class="inputWrapper">
                        <input type="password" id="password" class="inputBox" placeholder="Enter your password" required />
                        <button type="button" id="togglePassword" class="toggle-password">
                            @* <img src="https://cdn-icons-png.flaticon.com/512/6405/6405909.png" alt="Show/Hide" id="password-icon" /> *@
                            <i id="password-icon" class="fas fa-eye-slash"></i> 
                        </button>
                    </div>
                </div>
                <div class="signup-confirm-password">
                    <label class="label" for="confirm-password">Confirm Password</label>
                    <div class="inputWrapper">
                        <input type="password" id="confirm-password" class="inputBox" placeholder="Confirm your password" required />
                        <button type="button" id="toggleConfirmPassword" class="toggle-password">
                            <i id="confirm-password-icon" class="fas fa-eye-slash"></i> 
                        </button>
                    </div>
                </div>
                <button class="signup-back-button" id="signupBackButton">Back</button>
                <button class="signup-button" id="signupButton">Sign Up</button>
            </section>
        </div>

        <div class="signup-submit">
            @* <button class="signup-button" id="signupButton">Sign Up</button> *@

            <div class="signup-google-link">
                <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/c/c1/Google_%22G%22_logo.svg/2048px-Google_%22G%22_logo.svg.png" 
                alt="Google G Logo" 
                width="25">
                <p>Sign Up with Google</p>
            </div>
            <div class="signup-login-container"></div>
            <p>Already have and account ? 
                <a class="signup-login-link" href="/login">Log In</a>
            </p>
        </div>
    </form>
</div>

<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="~/js/Auth/Signup.js"></script>