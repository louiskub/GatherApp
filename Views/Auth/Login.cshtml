@model GatherApp.Models.User

@{
    ViewData["Title"] = "Login Page";
}

<head>
    <link rel="stylesheet" href="~/css/Auth/Login.css" />
    <title>Login Page</title>
</head>
<body>
    <h1 class="top">Log In</h1>
    <div class="page">
        <div class="containerStyle">
            <label class="label" for="username">Username :</label>
            <input
                type="text"
                id="username"
                class="inputBox"
                placeholder="Enter your username"
                required
            />
        </div>

        <div class="containerStyle">
            <label class="label" for="password">Password :</label>
            <div class="inputWrapper">
                <input
                    type="password"
                    id="password"
                    class="inputBox"
                    placeholder="Enter your password"
                    required
                />
                <button type="button" id="togglePassword" class="showButton">
                    <img
                        src="https://cdn-icons-png.flaticon.com/512/6405/6405909.png"
                        alt="Show/Hide"
                        id="icon"
                    />
                </button>
            </div>
        </div>

        <div class="buttonContainer">
            <div class="containerStyle">
                <button class="buttonStyle" onclick="buttonClick()">Log In</button>
            </div>

            <div class="containerStyle">
                <p class="textStyle">Not a member yet?</p>
                <a href="/signup" class="link">Sign Up</a>
            </div>
        </div>
    </div>

    <script src="~/js/Auth/Login.js"></script>
</body>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>

    async function buttonClick() {
        let username = $("#username").val();
        let password = $("#password").val();


        if (!username || !password) {
            alert("Please enter both username and password.");
            return;
        }


        try {
            await $.ajax({
                url: '/api/auth/login',
                type: 'POST',
                contentType: "application/json",
                data: JSON.stringify({ 
                    username: username, 
                    password: password
                }),
                success: function (response) {
                if(response.status == "Login success") {
                    window.location.href = "/home"; 
                } else {
                    alert(response.status);}
                },
                error: function (xhr) {
                    let errorMessage = xhr.responseJSON?.status || "Login failed";
                    alert(errorMessage);  
                }
            });
        } catch (err) {
            alert("An unexpected error occurred.");
        }
    }
</script>
