@model GatherApp.Models.User

@{
    ViewData["Title"] = "Login Page";
}

<h1>Login Page</h1>

<div>
    <div class="form-group">
        <label asp-for="Username"></label>
        <input type="text" asp-for="Username" id="username" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Password"></label>
        <input type="password" asp-for="Password" id="password" class="form-control" />
    </div>
    <div id="error" style="color: red;"></div>
    <button type="button" class="btn btn-primary mt-4" onclick="buttonClick()">Login</button>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>

    async function buttonClick() {
        let username = $("#username").val();
        let password = $("#password").val();


        if (!username || !password) {
            alert("Please enter both username and password.");
            return;
        }


        try {
            await $.ajax({
                url: '/api/auth/login',
                type: 'POST',
                contentType: "application/json",
                data: JSON.stringify({ 
                    username: username, 
                    password: password
                }),
                success: function (response) {
                if(response.status == "Login success") {
                    window.location.href = "/home"; 
                } else {
                    alert(response.status);}
                },
                error: function (xhr) {
                    let errorMessage = xhr.responseJSON?.errors || "Login failed";
                    alert(errorMessage);  
                }
            });
        } catch (err) {
            alert("An unexpected error occurred.");
        }
    }
</script>
