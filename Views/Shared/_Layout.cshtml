<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GatherApp</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Jost:wght@500;600&display=swap">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

    <link rel="stylesheet" href="~/css/site.css"/>
    <link rel="stylesheet" href="~/css/nav/navbar.css"/>

</head>

<body>
    <header>
        <nav class="navbar">
            <div class="left-navbar">
                <!-- Logo -->
                <a class="logo" href="/">Gather</a>

                <!-- Dark/Light Mode Toggle -->
                @* <button id="theme-toggle" class="theme-toggle">
                    <i class="fas fa-sun"></i>
                    <i class="fas fa-moon"></i>
                </button> *@
                <div class="theme-switch">
                    <input type="checkbox" class="theme-toggle" id="theme-toggle">
                    <label for="theme-toggle" class="switch">
                        <span class="text light-text">Light</span>
                        <i class="fa-solid fa-sun sun-icon"></i>
                        <i class="fa-solid fa-moon moon-icon"></i>
                        <span class="text dark-text">Dark</span>
                    </label>
                </div>
            </div>

            <!-- Search Bar -->
            <button class="search-icon" href="#">Search
                <i class="fa fa-search"></i>
            </button>
            <div class="search-container">
                <form class="search-bar">
                    <input type="text" placeholder="Search.." name="search" aria-label="Search">
                    <button type="submit" href="#"><i class="fa fa-search"></i></button>
                </form>
            </div>

            <!-- Right Navbar -->
            <div class="right-navbar"></div>

            <!-- Main Menu -->
            <div class="menu"></div>
        </nav>
    </header>
    <script>

        Headers = document.querySelector("header");
        Head = document.querySelector("head");
        Body = document.querySelector("body");
        RightNavbar = document.querySelector(".right-navbar");
        Menu = document.querySelector(".menu");

        const link = document.createElement("link");
        link.rel = "stylesheet";
        const script = document.createElement("script");

        if (localStorage.getItem('authorized') === null) {
            console.log("Unauthorized");

            link.href = "/css/nav/nav_unauth.css";
            script.src = "/js/nav/nav_unauth.js";

            Head.appendChild(link);
            Body.appendChild(script);

            RightNavbar.innerHTML = `
            <!-- Hamburger Menu -->
            <button class="menu-toggle">
            @* <i class="fas fa-ellipsis-v dropdown-icon"></i> *@
                <i class="fa fa-bars open-icon"></i>
                <i class="fa fa-times close-icon"></i>
            </button>`;

            Menu.innerHTML = `
            @* <a href="/">Home<i class="fa fa-fw fa-home"></i></a> *@
            <a href="/aboutus">About us<i class="fa fa-fw fa-info"></i></a>
            <a href="/login">Login<i class="fa fa-fw fa-user"></i></a>
            <a class="active" href="/signup">Sign up<i class="fa fa-user-plus"></i></a>`;
        }
        else {
            console.log('Authorized');
            link.href = "/css/nav/nav_auth.css";
            script.src = "/js/nav/nav_auth.js";

            Head.appendChild(link);
            Body.appendChild(script);

            RightNavbar.innerHTML = `                
            <button class="noti" href="#" aria-label="Notifications"><i class="fa fa-fw fa-bell"></i></button>
            <button class="menu-toggle" aria-label="Open Menu">
                <i class="fa fa-bars open-icon"></i>
                <i class="fa fa-times close-icon"></i>
            </button>`;

            Menu.innerHTML = `
            <div class="profile">
                <a href="/profile"><img src="https://i.pinimg.com/736x/26/6e/5c/266e5cc575f46b6b309f0e5864707ce1.jpg"></a>
                <p>UsernameKubeieijububu55567890</p>
            </div>

            <div class="menu-list">
                <a href="/history/post">Post History<i class="fa fa-history"></i></a>
                <a href="/history/application">Application History<i class="fa fa-file-alt"></i></a>
                <a href="#">Change Password<i class="fa fa-lock"></i></a>
                <a class="log-out" href="/">Logout<i class="fa fa-fw fa-sign-out"></i></a>
            </div>`;
        }

    </script>
    <script src="~/js/nav/navbar.js"></script>

    @RenderBody()

    <footer class="border-top footer">
        <div class="container">
            &copy; 2025 - GatherApp - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
