@{
    var isAuthorized = ViewBag.IsAuthorized as bool? ?? true;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="cache-control" content="max-age=0" />
    <meta http-equiv="cache-control" content="no-cache" />
    <meta http-equiv="expires" content="0" />
    <meta http-equiv="expires" content="Tue, 01 Jan 1980 1:00:00 GMT" />
    <meta http-equiv="pragma" content="no-cache" />
    <title>@ViewData["Title"] - GatherApp</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Jost:wght@500;600&display=swap">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

    <link rel="stylesheet" href="~/css/site.css"/>
    <link rel="stylesheet" href="~/css/nav/navbar.css"/>

</head>

<body>
    <header>
        <nav class="navbar">
            <div class="left-navbar">
                <!-- Logo -->
                <a class="logo" href="/">Gather</a>

                <!-- Dark/Light Mode Toggle -->
                @* <button id="theme-toggle" class="theme-toggle">
                    <i class="fas fa-sun"></i>
                    <i class="fas fa-moon"></i>
                </button> *@
                <div class="theme-switch">
                    <input type="checkbox" class="theme-toggle" id="theme-toggle">
                    <label for="theme-toggle" class="switch">
                        <span class="text light-text">Light</span>
                        <i class="fa-solid fa-sun sun-icon"></i>
                        <i class="fa-solid fa-moon moon-icon"></i>
                        <span class="text dark-text">Dark</span>
                    </label>
                </div>
            </div>

            <!-- Search Bar -->
            <button class="search-icon" href="#">Search
                <i class="fa fa-search"></i>
            </button>
            <div class="search-container">
                <form class="search-bar" id="search-bar" action="/search" method="get">
                    <input type="text" placeholder="Search.." name="keyword" aria-label="Search">
                    <button type="submit"><i class="fa fa-search"></i></button>
                </form>
            </div>

            <!-- Right Navbar -->
            <div class="right-navbar"></div>

            <!-- Main Menu -->
            <div class="menu"></div>
        </nav>
    </header>
    
    @* Headers = document.querySelector("header"); *@
    

    @if (isAuthorized)
    {
        <script src="/js/components/nav_louis/auth_nav.js"></script>
    }
    else
    {
        <script src="/js/components/nav_louis/unauth_nav.js"></script>
    }
    <script src="~/js/nav/navbar.js"></script>

    @RenderBody()

    @* <footer class="footer-container">
        <div class="footer-content">
            &copy; 2025 - GatherApp - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer> *@
    <script type="module">
        import ToastTemplate from "/js/components/handler/toast_template.js"
        const toastTemplate = new ToastTemplate();
        window.redirectToLogin = async function() {
            await toastTemplate.changeToast("You need to log in. Redirecting...", "/login");
            await toastTemplate.redirect("error");
        };
        window.changeToast = async (content, redirectPath, type) => {
            await toastTemplate.changeToast(content, redirectPath);
            await toastTemplate.redirect(type);
        }
        window.showToast = async (content, type) => {
            await toastTemplate.changeToast(content, "");
            await toastTemplate.showToast(type);
        }

        window.changePage = async (content, redirectPath, type) => {
            await toastTemplate.changeToast(content, redirectPath);
            await toastTemplate.redirect(type);
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
