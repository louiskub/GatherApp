@{
    ViewData["Title"] = "Gather-Profile";
}
<link rel="stylesheet" href="~/css/Home/viewprofile.css">
<link rel="stylesheet" href="~/css/src.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/bcryptjs/2.4.3/bcrypt.min.js"></script>

<main>
    <div class="sakura-bg" id="sakura-container"></div>

    <div class="container">
        <img class="profile-pic" id="profilepic" src="">

        <div class="edit-button">
            <button id="editbtn" onclick="toggleEdit()">✏️ Edit</button>
            <button id="savebtn" onclick="saveProfile()">✅ Save</button>
            <button id="cancelbtn" onclick="cancelEdit()">❌ Cancel</button>
        </div>

        <div class="popup-container" id="popupContainer">
            <div class="popup">
                <h2>Confirm Password</h2>

                <div class="password-container">
                    <input type="password" id="checkpassword" placeholder="Enter password">
                    <span class="toggle-password" onclick="togglePassword()">👁️‍🗨️</span>
                </div>

                <p id="error-message" style="color: red;"></p>
                <button class="confirmpass" onclick="confirmPassword()">Confirm</button>
                <button class="cancelpass" onclick="closePopup()">Cancel</button>
            </div>
        </div>

        <div class="upload_container" id="upload_container" style="display: none;">
            <input type="file" id="imageUpload" accept="image/*" />
            <div class="preview">
                <span class="upload_text">Upload Profile Picture</span>
            </div>
        </div>

        <div class="behavior-score">
            <input class="box" id="behaviorscore" type="text" value="" disabled>
        </div>

        <div class="form-container">
            <div class="form-group" id="usernamelabel">
                <label>Username 🩷</label>
                <input class="box" id="username" type="text" value="" disabled>
            </div>

            <div class="allnamebox">
                <div class="namebox">
                    <label>Name ⛱️</label>
                    <input class="box" id="name" type="text" value="" disabled>
                </div>
                <div class="namebox">
                    <label>Surname 🌸</label>
                    <input class="box" id="surname" type="text" value="" disabled>
                </div>
            </div>

            <div class="form-group">
                <label>Email 💌</label>
                <input class="box" id="email" type="text" value="" disabled>
            </div>
            <div class="form-group">
                <label>Birthdate 🎂</label>
                <input class="box" id="birthdate" type="date" value="" disabled>
            </div>
            <div class="form-group">
                <label>Sex ♂️♀️</label>
                <div id="sex-container">
                    <input class="box" id="sex" type="text" value="" disabled>
                    <div id="sex-dropdown-container" style="display: none;">
                        <select class="box sex-dropdown" id="sex-dropdown">
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                            <option value="Non-Binary">Non-Binary</option>
                            <option value="Prefer not to say">Prefer not to say</option>
                            <option value="custom">Custom...</option>
                        </select>
                        <input class="box" id="custom-sex" type="text" placeholder="Enter custom gender"
                            style="display: none;">
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label>Bio 💭</label>
                <textarea class="box" id="bio" disabled></textarea>
            </div>

            <div class="form-group" id="taglabel">
                <label>Tags 🏷️</label>
                <div id="tag-list"></div>
            </div>

        </div>

        <div class="rating-container">
            <label>🎀🍭❤️ Review Score ❤️🍭🎀</label>
            <div class="stars" id="stars-container"></div>
            <div class="ratingvalue" id="ratingvalue"></div>
        </div>

    </div>

    <div class="postcontainer">
        <input class="posttitle" type="text" value="My Post" disabled>
        <div id="posts-list"></div>
        <p class="postfooter"></p>
    </div>

    <script src="/js/Home/viewprofile.js"></script>

</main>