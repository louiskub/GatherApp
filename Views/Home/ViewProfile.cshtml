            // ดาว review
            const starSvg = `<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>`;

            // Function to render stars based on rating
            function renderStars(receivedRatings) {
            const starsContainer = document.getElementById('stars-container');
            starsContainer.innerHTML = '';
            
            const fullStars = Math.floor(receivedRatings);
            const hasHalfStar = receivedRatings % 1 >= 0.5;
            
            // Render full stars
            for (let i = 0; i < fullStars; i++) {
                const star = document.createElement('div');
                star.className = 'star star-full';
                star.innerHTML = starSvg;
                starsContainer.appendChild(star);
            }
            
            // Render half star if needed
            if (hasHalfStar) {
                const starContainer = document.createElement('div');
                starContainer.className = 'star';
                
                const emptyStar = document.createElement('div');
                emptyStar.className = 'star-empty';
                emptyStar.innerHTML = starSvg;
                
                const halfStar = document.createElement('div');
                halfStar.className = 'star-half';
                halfStar.innerHTML = starSvg;
                
                starContainer.appendChild(emptyStar);
                starContainer.appendChild(halfStar);
                starsContainer.appendChild(starContainer);
            }
            
            // Fill remaining with empty stars
            const remainingStars = 5 - fullStars - (hasHalfStar ? 1 : 0);
            for (let i = 0; i < remainingStars; i++) {
                const star = document.createElement('div');
                star.className = 'star star-empty';
                star.innerHTML = starSvg;
                starsContainer.appendChild(star);
            }

            // Create and animate sakura petals
            (function() {
            const sakuraContainer = document.getElementById('sakura-container');
            const windowWidth = window.innerWidth;
            
            // Create 50 petals
            for (let i = 0; i < 50; i++) {
                createPetal();
            }
            
            function createPetal() {
                // Create petal element
                const petal = document.createElement('div');
                petal.className = 'sakura-petal';
                
                // Random properties
                const left = Math.random() * windowWidth;
                const size = Math.random() * 15 + 15; // 15-30px
                const durationFall = Math.random() * 10 + 8; // 8-18s
                const delay = Math.random() * 15;
                
                // Random petal color
                const colors = ['light', 'medium', 'dark'];
                const colorClass = colors[Math.floor(Math.random() * colors.length)];
                petal.classList.add(colorClass);
                
                // Apply styles
                petal.style.left = `${left}px`;
                petal.style.width = `${size}px`;
                petal.style.height = `${size}px`;
                petal.style.animationDuration = `${durationFall}s`;
                petal.style.animationDelay = `${delay}s`;
                
                // Add to container
                sakuraContainer.appendChild(petal);
                
                // Remove petal after animation completes
                setTimeout(() => {
                petal.remove();
                }, (durationFall + delay) * 1000);
            }
            
            // Create new petals occasionally
            setInterval(createPetal, 300);
            
            // Handle window resize
            window.addEventListener('resize', () => {
                windowWidth = window.innerWidth;
            });
            })();
            
            // Update rating text
            document.getElementById('rating-text').textContent = `Current rating: ${receivedRatings} out of 5`;
            }
            
            // Initialize with default rating
            @* let currentRating = receivedRatings;
            renderStars(currentRating); *@
            
            @* // Update stars when input changes
            const ratingInput = document.getElementById('rating-input');
            ratingInput.addEventListener('input', function() {
            const newRating = parseFloat(this.value);
            if (!isNaN(newRating) && newRating >= 0 && newRating <= 5) {
                currentRating = newRating;
                renderStars(currentRating);
            }
            }); *@


            document.addEventListener("DOMContentLoaded", function() {
                fetchMyProfile(); // โหลดข้อมูลและปรับขนาด textarea หลังจากนั้น
            });
            
            document.addEventListener("DOMContentLoaded", async function () {
                async function fetchPosts() {
                    try {
                        let response = await fetch(`api/user/getmyposts`, {
                            method: "GET",
                            credentials: "include"
                        });

                        if (!response.ok) throw new Error("Failed to fetch posts");

                        let data = await response.json();  // ✅ แก้ให้รอ await
                        console.log("Fetched data:", data);

                        return data;  // ✅ คืนค่าทั้ง object { posts: [...], isOwner: true }
                    } catch (error) {
                        console.error("Error loading posts:", error);
                        return { posts: [] }; // ✅ ป้องกัน error
                    }
                }



                function renderPosts(post) {
                    const postsList = document.getElementById("posts-list");

                    const postItem = document.createElement("div");
                    postItem.classList.add("post-item");

                    postItem.innerHTML = `
                        <div class="post-card">
                            <img src="your-image-url.jpg" alt="Post Image" class="post-image">
                            <div class="post-content">
                                <span class="post-date">${new Date(post.createdAt).toLocaleString()}</span>
                                <h3 class="post-title">${post.postName}</h3>
                                <p class="post-location"><i class="fa-solid fa-location-dot"></i> Ang Thong, Chaiyo</p>
                                <p class="post-meta">Accepted: 0/5 | Registered: 0</p>
                                <div class="post-tags">
                                    <span class="tag">#Windsurfing</span>
                                    <span class="tag">#Running ❤️</span>
                                </div>
                            </div>
                        </div>
                    `;

                    postsList.appendChild(postItem);
                }


                @* const allPosts = await fetchPosts();
                console.log("All posts:", allPosts);
                
                renderPosts(allPosts); *@
                document.addEventListener("DOMContentLoaded", async function () {
                    const allPosts = await fetchPosts(); // ✅ allPosts เป็น object { posts: [...], isOwner: true }

                    console.log("All posts:", allPosts);
                    console.log("posts",allPosts.post)

                    if (allPosts.posts && Array.isArray(allPosts.posts)) {
                        allPosts.posts.forEach(post => renderPosts(post)); // ✅ ส่งเข้า render ทีละ post
                    } else {
                        console.error("Invalid posts structure:", allPosts);
                    }
                });

                console.log("Raw allPosts:", allPosts);
                console.log("Type of allPosts:", typeof allPosts);
                console.log("First element:", allPosts[0]);
                console.log("Type of first element:", typeof allPosts[0]);
                console.log("Is first element an array?", Array.isArray(allPosts[0]));


            });
            
        </script> 

