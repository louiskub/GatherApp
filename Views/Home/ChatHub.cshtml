@{
    ViewData["Title"] = "Chat Page";
}

<head>
    <link rel="stylesheet" href="~/css/Chat/Chat.css" />
    <title>Chat Page</title>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.9/signalr.min.js"></script>
</head>

<body>
    <h1 class="top">Chat Room</h1>

    <div class="chatContainer">
        <div class="chatBox" id="chatBox"></div>

        <!-- ขยับ Input Post ID ลงมาติดแชท -->
        <div class="chatInput">
            <label for="postIdInput">Enter Post ID:</label>
            <input type="text" id="postIdInput" class="inputBox" placeholder="Post ID" required />
            <button class="buttonStyle" onclick="joinChat()">Join Chat</button>
        </div>

        <div class="chatInput">
            <input type="text" id="messageInput" class="inputBox" placeholder="Type your message..." required />
            <button class="buttonStyle" onclick="sendMessage()">Send</button>
        </div>
    </div>

    <script src="~/js/Chat/Chat.js"></script>
</body>
