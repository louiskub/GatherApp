<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chat</title>
    <style>
        body {
            font-family: Arial, sans-serif;
        }
        #chatWindow {
            width: 80%;
            height: 400px;
            border: 1px solid #ccc;
            overflow-y: scroll;
            margin: 20px auto;
            padding: 10px;
        }
        #messageBox {
            width: 80%;
            padding: 10px;
            margin: 20px auto;
            display: flex;
            justify-content: space-between;
        }
        #messageInput {
            width: 85%;
            padding: 10px;
        }
        #sendMessage {
            padding: 10px 20px;
            cursor: pointer;
        }
    </style>
</head>
<body>

<h2>Chat</h2>

<div id="chatWindow"></div>

<div id="messageBox">
    <input type="text" id="messageInput" placeholder="Type your message..." />
    <button id="sendMessage">Send</button>
</div>

<!-- Include the SignalR client library -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/signalr/5.0.6/signalr.min.js"></script>

<script>
    // Get user and postId from some source or prompt the user for these details
    const postId = prompt("Enter the Post ID you want to join:");
    const userId = "user10"; // You can replace this with the actual logged-in userId from your session

    // Create a connection to the SignalR Hub
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/chatHub")
        .configureLogging(signalR.LogLevel.Information)
        .build();

    // On receiving a message, append it to the chat window
    connection.on("ReceiveMessage", (user, message, sentAt) => {
        const chatWindow = document.getElementById("chatWindow");
        const messageElement = document.createElement("div");
        messageElement.innerText = `[${sentAt}] ${user}: ${message}`;
        chatWindow.appendChild(messageElement);
        chatWindow.scrollTop = chatWindow.scrollHeight; // Scroll to the bottom
    });

    // Handle error messages
    connection.on("Error", (errorMessage) => {
        alert(errorMessage);
    });

    // Join chat when the page loads
    connection.start().then(() => {
        connection.invoke("JoinChat", postId).catch(err => console.error("Error joining chat:", err));
    }).catch(err => console.error("Error starting connection:", err));

    // Send message when clicking the send button
    document.getElementById("sendMessage").addEventListener("click", () => {
        const message = document.getElementById("messageInput").value;
        if (message) {
            connection.invoke("SendMessage", postId, userId, message).catch(err => console.error("Error sending message:", err));
            document.getElementById("messageInput").value = ""; // Clear input field
        }
    });

    // Allow pressing "Enter" to send message
    document.getElementById("messageInput").addEventListener("keydown", (event) => {
        if (event.key === "Enter") {
            event.preventDefault(); // Prevent the default "Enter" action (e.g., form submission)
            document.getElementById("sendMessage").click();
        }
    });

    // Optional: handle leaving the chat
    function leaveChat() {
        connection.invoke("LeaveChat", postId).catch(err => console.error("Error leaving chat:", err));
    }

    // Call leaveChat when the user navigates away or closes the page
    window.onbeforeunload = leaveChat;
</script>

</body>
</html>
