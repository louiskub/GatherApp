@* <link rel="stylesheet" href="~/css/inform/report.css"> *@

<div class="main">
    <div class="report-all">

        <div class="report-header">
            <h3><i class="fa-solid fa-flag"></i></h3>
            <h2>Report Abuse</h2>
        </div>

        <div class="report-container">
            <div class="report-img-container">
                <img 
                    src="https://devforum-uploads.s3.dualstack.us-east-2.amazonaws.com/uploads/original/4X/9/0/f/90f25d6a2527e12dedbe03da1f6c5670d0c4902d.png" 
                    alt="profile"
                    class="img-profile" 
                >
                <div class="img-username">
                    Usernamenamenamenamename
                </div>
            </div>
            
            <div class="report-content">
                <div class="report-describe">
                    <hr>
                    Select Topic to Report 
                </div>
                <div class="report-checkbox-container">
                    <div class="report-checkbox">
                        <button class="report-choice"  contenteditable="false"> Harassment </button>
                        <button class="report-choice"> Violence </button>
                        <button class="report-choice"> Hate speech </button>
                        <button class="report-choice"> Fraud or scam </button>
                        <button class="report-choice"> Phising </button>
                        <button class="report-choice"> Other </button>
                    </div>
                    <textarea id="w3review" name="w3review" rows="5" cols="40" 
                    placeholder="Reason for your reporting" maxlength="50"></textarea>
                </div>
            </div>
        </div>

        <div class="report-btn-container">
            <button id="cancel-btn">Cancel</button>
            <button id="report-btn">Report</button>
        </div>
    </div>
</div>


<script type="module">
    import loadCss from "/js/components/reuse_func.js";

    document.querySelectorAll(".report-choice").forEach((element) => {
        element.addEventListener("click", () => {
            element.classList.toggle("report-active");
        });
    });

    document.addEventListener("DOMContentLoaded", async function() {
        await loadCss("/css/inform/report.css");
    });
</script>