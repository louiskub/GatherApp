@{
    ViewData["Title"] = "Gather-Search";
}

    @* <link rel="stylesheet" href="~/css/components/dropdown.css">
    <link rel="stylesheet" href="~/css/components/post.css">
    <link rel="stylesheet" href="~/css/components/post_in_date.css">
    <link rel="stylesheet" href="~/css/components/filter_button.css">
    <link rel="stylesheet" href="~/css/search/search.css"> *@

    <div class="main">
        <div class="sidenav"></div>
        <div class="search-content">
            <div class="search-filter">
                @* <button class="active" id="search-all">All</button>
                <button id="search-user">User</button>
                <button id="search-post">Post</button> *@
            </div>
            <div class="search-results-container">
                <div class="search-results-user">
                    @* <h1> User Results</h1> *@
                    <div class="search-user-container"></div>
                    <div class="search-more-user-container"></div>
                </div>
                <div class="search-results-post">
                    @* <h1> Post Results</h1> *@
                    <button class="dropdown-toggle" href="#">
                        <i class="fas fa-sliders dropdown-icon"></i> Filter
                    </button>
                    <div class="search-post-container"></div>
                </div>
            </div>
        </div>
    </div>

    <script type="module" src="~/js/search/search.js"></script>