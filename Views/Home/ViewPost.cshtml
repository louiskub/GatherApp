<script>
    function openPopup() {
        document.getElementById("popup_app").style.display = "block";
        document.getElementById("overlay").style.display = "block";
    }

    function openeditPopup() {
        document.getElementById("popup_create").style.display = "flex";
        document.body.classList.add('popup-open');
    }

    function closePopup() {
        document.getElementById("popup_app").style.display = "none";
        document.getElementById("overlay").style.display = "none";
    }

    function closeeditPopup() {
        document.getElementById("popup_create").style.display = "none";
        document.body.classList.remove('popup-open');
    }

    function submitApplication() {
        const fileInput = document.getElementById("fileInput");
        if (fileInput.files.length === 0) {
            window.showToast("Please attach your application.", "warning");
        } else {
            closePopup();
        }
    }
</script>