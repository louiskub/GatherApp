@{
    ViewData["Title"] = "Gather-ApplicationHistory";

<link rel="stylesheet" href="~/css/History/appHistory.css">

<div class="pageContainer">
  <h1 class="top">Application History</h1>

  <div class="containerStyle">
    <div class="indicator finish"></div>
    <div class="innerContainer">

      <div class="contentStyle">
        <h2>Activity Name 1</h2>
        <p>Date: Thu, Jan 30, 6:30 PM - 9:30 PM</p>
      </div>

      <div class="statusContainer">
        <div class="buttonContainer">
          <button class="buttonStyle review">Review</button>
          <button class="buttonStyle report">Report</button>
        </div>
      </div>

    </div>
  </div>


  <div class="containerStyle">
    <div class="indicator accept"></div>
    <div class="innerContainer">
      <div class="contentStyle">
        <h2>Movie Night</h2>
        <p>Date: Thu, Jan 30, 6:30 PM - 9:30 PM</p>
      </div>

      <div class="statusContainer">
        <p class="textStyle">Accepted</p>
        <button class="buttonStyle report">Cancel</button>
      </div>
    </div> 
  </div>


  <div class="containerStyle">
    <div class="indicator pending"></div>
    <div class="innerContainer">
      <div class="contentStyle">
        <h2>Activity Name 1</h2>
        <p>Date: Thu, Jan 30, 6:30 PM - 9:30 PM</p>
      </div>

      <div class="statusContainer">
          <p class="textStyle"> Pending </p>
          <button class="buttonStyle report">Cancel</button>
      </div>
    </div>
  </div>

  <div class="containerStyle">
    <div class="indicator reject"></div>
    <div class="innerContainer">
      <div class="contentStyle">
        <h2>Activity Name 1</h2>
        <p>Date: Thu, Jan 30, 6:30 PM - 9:30 PM</p>
      </div>

      <div class="statusContainer" id="reject">
        <p class="textStyle">Rejected</p>
      </div>
    </div>
  </div>


</div>