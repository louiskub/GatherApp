@{
    ViewData["Title"] = "Gather-PopupHistory";
}

<link rel="stylesheet" href="~/css/History/popupHistory.css">

<div class="main">
    <button class="buttonStyle review">Review</button>
    <button class="buttonStyle report">Report</button>

    <div class="popup-container">
        <i class="fa-solid fa-xmark close-popup-icon"></i>
        <div class="popup-header">
            <h2>Registrant:add 57</h2>
        </div>
        <div class="popup-content">
            <div class="all-user-content">
                <div class=""></div>
            </div>
        </div>


    </div>
</div>
<script>
    var popup = document.querySelector('.popup');
    var review = document.querySelector('.review');
    var report = document.querySelector('.report');
    var close = document.querySelector('.close-popup-icon');

    function openPopup() {
        popup.style.display = 'flex';
        document.body.classList.add("no-scroll"); // ปิดการเลื่อน
    }

    function closePopup() {
        popup.style.display = 'none';
        document.body.classList.remove("no-scroll"); // เปิดการเลื่อนกลับมา
    }

    review.addEventListener('click', openPopup);
    report.addEventListener('click', openPopup);
    close.addEventListener('click', closePopup);

    window.addEventListener('click', function (e) {
        if (e.target == popup) {
            closePopup();
        }
    });
</script>