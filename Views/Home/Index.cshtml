@{
    ViewData["Title"] = "Gather-Home";
}   
    @* @await Html.PartialAsync("_NavUnAuth") *@

    <link rel="stylesheet" href="~/css/GOLF/createpost.css">
    <link rel="stylesheet" href="~/css/home/home.css">

    <div class="main">
        <button class="dropdown-toggle" href="#">
            <i class="fas fa-sliders dropdown-icon"></i> Filter
        </button>

        <div class="sidenav"></div>
        <div class="home-content">
            @* <div class="write-button">
                <img src="https://cdn-icons-png.flaticon.com/512/84/84380.png" alt="Write">
            </div> *@

            <div class="floating-menu-button" onclick="toggleFloatingMenu()">
                <i class="fas fa-plus floating-menu-icon"></i> 
            </div>

            <div class="floating-menu" id="floatingMenu">
                <div class="floating-menu-item" data-tooltip="About Us" id="menu-aboutus-button">
                    <i class="fas fa-info-circle aboutus-item-icon"></i>
                </div>
                <div class="floating-menu-item" data-tooltip="Chat Hub" id="menu-chat-button">
                    <i class="fas fa-comments chat-item-icon"></i>
                </div>
                <div class="floating-menu-item" data-tooltip="Create Post" id="menu-write-button">
                    <i class="fas fa-pencil-alt createpost-item-icon"></i>
                </div>
            </div>


            <div class="popup_create" id="createPostPopup">
                <div class="popup_create_content">
                    <div class="popup_create_content_left">
                        <h2>Create Post</h2>
                        <div class="img_des_box">  
                            <div class="upload_container">
                                <input type="file" id="imageUpload" accept="image/*" style="display: none;" />
                                <div class="preview">
                                    <div class="preview_text">
                                        <span class="upload_text">Upload Image</span>
                                        <span class="upload_text_rec">Recommend 1200x550 pixels</span>
                                    </div>
                                    <img id="previewImage" src="" alt="Preview" style="display: none;">
                                </div>
                            </div>
                            <textarea class="descript_create" placeholder="Description"></textarea>
                        </div>
                    </div>
                    <div class="popup_create_content_right">
                        <div class="create_act_name">
                            <input type="text" placeholder="Activity Name">
                        </div>

                        <div class="tag-container" id="tag-container">
                            <div class="tag-list" id="tag-list">
                                <span class="tag-placeholder" id="tag-placeholder">Select up to 3 tags</span>
                            </div>
                            <div class="tag-options" id="tag-options">
                                <div class="tag-limit-msg" id="tag-limit-msg">Only 3 tags can be selected</div>
                            </div>
                        </div>

                        <div class="event_type_selection">
                            <select id="eventTypeSelect" class="event-type-select">
                                <option value="" disabled selected>Select Event Type</option>
                                <option value="onsite">Onsite</option>
                                <option value="online">Online</option>
                            </select>
                        </div>

                        <div id="locationFields">
                            <div class="create_location">
                                <div class="location_container"></div>
                            </div>
                            <div class="google_map_link">
                                <div class="input_map_link">
                                    <input type="text" placeholder="Google Map Link">
                                </div>
                                <div class="map_teach">
                                    <a href="https://www.youtube.com/watch?v=IiWCCFtKU8c" target="_blank" class="map-link">
                                        🌍<span class="link-text">Discover how to get the Google Map link</span>🗺️
                                    </a>
                                </div>
                            </div>
                        </div>
                        
                        <div class="event_date">
                            <label for="eventdate">📅Event Date</label>
                            <input type="datetime-local" id="eventdate" class="event-date-input">
                            <p id="event-error-msg" style="color: red; font-size: 14px; display: none;">
                                ⛔Event date must be after the deadline
                            </p>
                        </div>
                        
                        <div class="app_deadline">
                            <label for="deadline">📅Application Deadline</label>
                            <input type="datetime-local" id="deadline" class="deadline-input">
                            <p id="deadline-error-msg" style="color: red; font-size: 14px; display: none;">
                                ⛔Please select a date and time in the future
                            </p>
                        </div>
                        <div class="parti_needed">
                            <input type="number" placeholder="Participants needed" min="0" step="1">
                        </div>                    
                        <div class="check_attach_file">
                            <label><input type="checkbox"> Attach file</label>
                        </div>
                        <div class="popup-actions">
                            <button class="cancel_but" onclick="closePopup()">Cancel</button>
                            <button class="create_but" onclick="createpost()">Create</button>
                        </div>
                    </div>
                </div>
            </div>        
        </div>
    </div>

    <script src="~/js/GOLF/createpost.js"></script>
    <script type="module" src="~/js/home/home.js"></script>
    <script>
        @* function toggleFloatingMenu() {
            const menu = document.getElementById('floatingMenu');
            menu.classList.toggle('active');
        } *@

        function toggleFloatingMenu() {
            document.getElementById('floatingMenu').classList.toggle('show');
        }

        function openCreatePostPopup() {
            document.getElementById('createPostPopup').style.display = 'block';
        }

        document.getElementById("menu-aboutus-button").addEventListener("click", function() {
        window.location.href = "/aboutus";
        });

        document.getElementById("menu-chat-button").addEventListener("click", function() {
        window.location.href = "/GlobalChat";
        });

    </script>